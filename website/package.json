{
  "name": "ttc-delays",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd api && ../.venv/bin/python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "cd api && ../.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "postinstall": "npm install --prefix frontend",
    "prepare-data": "test -f data/delays.db || gunzip -kf data/delays.db.gz",
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r api/requirements.txt && npm install && npm run prepare-data",
    "ingest": ".venv/bin/python .dev/tools/ingest_delays.py",
    "fetch-network": ".venv/bin/python .dev/tools/fetch_gtfs_network.py",
    "rebuild-data": "npm run ingest && npm run fetch-network"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
