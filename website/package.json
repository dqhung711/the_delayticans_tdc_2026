{
  "name": "ttc-delays",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node scripts/run-python.cjs --cwd api -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "node scripts/start-server.cjs",
    "postinstall": "node scripts/install-frontend.cjs",
    "prepare-data": "node scripts/prepare-data.cjs",
    "setup": "node scripts/setup.cjs",
    "ingest": "node scripts/run-python.cjs .dev/tools/ingest_delays.py",
    "fetch-network": "node scripts/run-python.cjs .dev/tools/fetch_gtfs_network.py",
    "rebuild-data": "npm run ingest && npm run fetch-network"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
